{
  "name": "macrotrackr",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun run --cwd backend dev & bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "build:backend": "bun run --cwd backend build",
    "start": "bun run --cwd backend start",
    "test": "bun run --cwd frontend test",
    "lint": "bun run --cwd frontend lint",
    "typecheck": "bun run --cwd backend typecheck & bun run --cwd frontend typecheck",
    "cap:sync": "bun run --cwd frontend cap:sync",
    "cap:sync:local": "bun run --cwd frontend cap:sync:local",
    "cap:sync:prod": "bun run --cwd frontend cap:sync:prod",
    "cap:open:ios": "bun run --cwd frontend cap:open:ios",
    "cap:open:android": "bun run --cwd frontend cap:open:android",
    "cap:run:ios": "bun run --cwd frontend cap:run:ios",
    "cap:run:android": "bun run --cwd frontend cap:run:android"
  },
  "devDependencies": {
    "@types/react-syntax-highlighter": "^15.5.13",
    "typescript": "^5.9.3"
  },
  "comment:overrides": "@clerk/shared 3.x is vulnerable at <=3.47.4 (GHSA-w24r-5266-9c3c, GHSA-vqx2-fgx2-5wq9). Pinned to the patched 3.x line: 4.x is a major bump that violates @clerk/clerk-react's own ^3.47.2 constraint.",
  "overrides": {
    "@clerk/shared": "^3.47.5"
  }
}
