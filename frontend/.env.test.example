# Playwright e2e config. Copy to frontend/.env.test, then run:
#   bun run --cwd frontend test:e2e

# Keys from a Clerk development instance (pk_test_ / sk_test_), never production.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# An existing user on that instance. Global setup links it and fills its
# profile on the suite's fresh database. Leave unset to skip signed-in specs.
E2E_CLERK_USER_EMAIL=someone+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=
