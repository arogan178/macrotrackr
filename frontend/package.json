{
  "name": "macrotrackr-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "build": "bunx vite build",
    "postbuild": "(bun ./scripts/generate-sitemap.js || node ./scripts/generate-sitemap.js) && (bun ./scripts/prerender.mjs || node ./scripts/prerender.mjs)",
    "preview": "bunx vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src && node ./scripts/check-ui-budgets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config ./playwright.config.ts",
    "test:e2e:ui": "playwright test --config ./playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config ./playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config ./playwright.config.ts --headed",
    "test:growth-canary": "playwright test --config ./e2e/growth-canary.config.ts",
    "cap:sync": "CAPACITOR=true bun run build && bunx cap sync",
    "cap:sync:local": "CAPACITOR_HOSTNAME=\"localhost\" VITE_API_URL=\"http://192.168.0.166:3000\" CAPACITOR=true bun run build && bunx cap sync",
    "cap:sync:prod": "CAPACITOR_HOSTNAME=\"app.macrotrackr.com\" VITE_API_URL=\"https://macrotrackr.com\" CAPACITOR=true bun run build && bunx cap sync",
    "cap:open:ios": "bunx cap open ios",
    "cap:open:android": "CAPACITOR_ANDROID_STUDIO_PATH=\"${CAPACITOR_ANDROID_STUDIO_PATH:-/opt/android-studio/bin/studio.sh}\" bunx cap open android",
    "cap:run:ios": "bunx cap run ios",
    "cap:run:android": "bunx cap run android",
    "build:analyze": "bunx vite build --mode analyze",
    "bundle:size": "node scripts/analyze-bundle.js",
    "ui:budgets": "node ./scripts/check-ui-budgets.mjs",
    "release:blog": "node ./scripts/release-note-to-blog.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-native-biometric": "^8.6.2",
    "@clerk/react": "^6.14.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@posthog/react": "^1.10.3",
    "@tanstack/query-async-storage-persister": "^5.99.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-persist-client": "^5.99.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.525.0",
    "motion": "^12.38.0",
    "posthog-js": "^1.369.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^2.15.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "workbox-routing": "^7.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@clerk/backend": "3.16.4",
    "@clerk/testing": "^2.2.22",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "@tanstack/router-plugin": "^1.167.22",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "cssnano": "^7.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.4.2",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8",
    "workbox-precaching": "^7.4.0"
  }
}
