{
  "name": "macrotrackr-frontend",
  "private": true,
  "version": "3.6.0",
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "build": "node ./scripts/check-support-email.mjs && bunx vite build",
    "postbuild": "bunx vite build --ssr src/entry-prerender.tsx --outDir dist-ssr --emptyOutDir && (bun ./scripts/generate-sitemap.js || node ./scripts/generate-sitemap.js) && (bun ./scripts/prerender.mjs || node ./scripts/prerender.mjs)",
    "preview": "bunx vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src && node ./scripts/check-ui-budgets.mjs && node ./scripts/check-assetlinks.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test --config ./playwright.config.ts",
    "test:e2e:ui": "playwright test --config ./playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config ./playwright.config.ts --debug",
    "test:e2e:headed": "playwright test --config ./playwright.config.ts --headed",
    "test:growth-canary": "playwright test --config ./e2e/growth-canary.config.ts",
    "cap:sync": "CAPACITOR=true bun run build && bunx cap sync",
    "cap:sync:local": "CAPACITOR=true CAPACITOR_HOSTNAME=localhost VITE_AUTH_MODE=clerk sh -c 'bunx vite build --mode development && bunx cap sync'",
    "cap:sync:prod": "CAPACITOR_HOSTNAME=\"app.macrotrackr.com\" VITE_API_URL=\"https://macrotrackr.com\" CAPACITOR=true bun run build && bunx cap sync",
    "cap:open:ios": "bunx cap open ios",
    "cap:open:android": "CAPACITOR_ANDROID_STUDIO_PATH=\"${CAPACITOR_ANDROID_STUDIO_PATH:-/opt/android-studio/bin/studio.sh}\" bunx cap open android",
    "cap:run:ios": "bunx cap run ios",
    "cap:run:android": "bunx cap run android",
    "build:analyze": "bunx vite build --mode analyze",
    "bundle:size": "node scripts/analyze-bundle.js",
    "ui:budgets": "node ./scripts/check-ui-budgets.mjs",
    "verify:assetlinks": "node ./scripts/check-assetlinks.mjs",
    "verify:support-email": "node ./scripts/check-support-email.mjs",
    "release:blog": "node ./scripts/release-note-to-blog.mjs",
    "seo:indexnow": "node ./scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@clerk/react": "^6.18.0",
    "@codetrix-studio/capacitor-google-auth": "3.4.0-rc.4",
    "@elysiajs/eden": "^1.4.9",
    "@tanstack/offline-transactions": "1.0.61",
    "@tanstack/query-async-storage-persister": "^5.104.5",
    "@tanstack/query-db-collection": "1.3.4",
    "@tanstack/react-db": "0.5.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-persist-client": "^5.104.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.13.24",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "posthog-js": "^1.438.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "workbox-routing": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@clerk/backend": "3.16.4",
    "@clerk/testing": "^2.2.49",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "0.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "cssnano": "^7.1.9",
    "dotenv": "^17.4.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-checker": "^0.10.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-precaching": "^7.4.1"
  }
}
