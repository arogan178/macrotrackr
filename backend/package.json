{
  "name": "macrotrackr-backend",
  "version": "2.6.0",
  "description": "Backend API for MacroTrackr application",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "if [ -f .env.production ]; then bun --env-file .env.production run src/index.ts; else bun run src/index.ts; fi",
    "dev": "if [ -f .env.development ]; then bun --env-file .env.development --watch src/index.ts; else bun --watch src/index.ts; fi",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "migrate:clerk:dev": "if [ -f .env.development ]; then bun --env-file .env.development run scripts/migrate-dev-users-to-clerk.ts; else bun run scripts/migrate-dev-users-to-clerk.ts; fi",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "bun test .integration.test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "elysia",
    "bun",
    "macros",
    "tracker",
    "api"
  ],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.12",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.28",
    "elysia-clerk": "^1.0.2",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "resend": "^4.8.0",
    "stripe": "^18.5.0",
    "svix": "^2.7.0",
    "zod": "^4.6.5"
  }
}
