{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "enabledManagers": ["bun", "github-actions", "dockerfile"],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "One weekly PR for all minor and patch updates. Majors stay separate.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates"
    },
    {
      "description": "Handled manually: motion 14, TanStack Table 9. Remove entries as each lands.",
      "matchPackageNames": [
        "motion",
        "@tanstack/react-table"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
